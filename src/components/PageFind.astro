---
import Search from "astro-pagefind/components/Search.astro";
---

<aside data-pagefind-ignore>
  <div
    transition:persist
    id="backdrop"
    class="bg-[rgba(0, 0, 0, 0.5] invisible opacity-0 transition-opacity fixed top-0 left-0 z-50 flex h-screen w-full justify-center p-6 backdrop-blur-xs">
    <div class="mx-auto w-full max-w-120">
      <Search
        instance="search"
        className="pagefind-ui"
        searchboxOptions={{
          showImages: false,
          excerptLength: 15,
          debounce: 150,
        }}
        configOptions={{
          instance: "search",
          preload: true,
        }}
      />
    </div>
  </div>
</aside>

<script is:inline>
  const magnifyingGlass = document.getElementById("magnifying-glass");
  const backdrop = document.getElementById("backdrop");

  function openPagefind() {
    const searchEl = document.querySelector("pagefind-searchbox");
    const input = searchEl?.shadowRoot?.querySelector("input") || searchEl?.querySelector("input");

    setTimeout(() => {
      input.focus();
    }, 0);
    backdrop?.classList.remove("invisible", "opacity-0");
    backdrop?.classList.add("visible", "opacity-100");
  }

  function closePagefind() {
    const searchEl = document.querySelector("pagefind-searchbox");
    const input = searchEl?.shadowRoot?.querySelector("input") || searchEl?.querySelector("input");
    if (input) input.value = "";

    backdrop?.classList.remove("visible", "opacity-100");
    backdrop?.classList.add("invisible", "opacity-0");
  }

  magnifyingGlass?.addEventListener("click", () => {
    openPagefind();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "/") {
      e.preventDefault();
      openPagefind();
    } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openPagefind();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closePagefind();
    }
  });

  document.addEventListener("click", (event) => {
    const path = event.composedPath();
    const isResult = path.some(
      (el) => el.classList?.contains("pf-searchbox-result") || el.tagName === "A"
    );
    if (isResult) {
      closePagefind();
    }
  });

  backdrop?.addEventListener("click", (event) => {
    if (!event.target.closest("pagefind-searchbox")) {
      closePagefind();
    }
  });
</script>

<style is:global>
  :root {
    --pf-font: var(--font-sans);
    --pf-background: var(--color-neutral-100);
    --pf-text: var(--color-neutral-900);
    --pf-text-secondary: var(--color-neutral-600);
    --pf-border: var(--color-neutral-300);
    --pf-border-focus: var(--color-green-700);
    --pf-hover: var(--color-neutral-200);
    --pf-mark: var(--color-green-700);
    --pf-input-height: 2rem;
    --pf-input-font-size: var(--text-sm);
    --pf-outline-focus: var(--color-green-700);
    --scrollbar-track: var(--color-neutral-200);
    color-scheme: light;
  }

  [data-pf-theme="dark"] {
    --pf-font: var(--font-sans);
    --pf-background: var(--color-neutral-900);
    --pf-text: var(--color-neutral-100);
    --pf-text-secondary: var(--color-neutral-400);
    --pf-border: var(--color-neutral-700);
    --pf-border-focus: var(--color-green-700);
    --pf-hover: var(--color-neutral-800);
    --pf-mark: var(--color-green-700);
    --pf-input-height: 2rem;
    --pf-input-font-size: var(--text-sm);
    --pf-outline-focus: var(--color-green-700);
    --scrollbar-track: var(--color-neutral-800);
    color-scheme: dark;
  }

  #backdrop.invisible pagefind-searchbox {
    display: none;
  }

  #backdrop.visible pagefind-searchbox {
    display: block;
  }

  pagefind-searchbox {
    --pf-outline-focus: var(--color-green-700);
  }

  pagefind-searchbox::part(input):focus,
  pagefind-searchbox::part(input):focus-visible {
    outline: 2px solid var(--color-green-700);
    outline-offset: 2px;
    border-color: var(--color-green-700);
  }

  /* ===== Scrollbar CSS ===== */
  /* Firefox */
  .pf-searchbox-results {
    scrollbar-width: thin;
    scrollbar-color: var(--color-green-800) var(--scrollbar-track);
  }

  .pf-searchbox-results:hover,
  .pf-searchbox-results:active {
    scrollbar-color: var(--color-green-700) var(--scrollbar-track);
  }

  /* Chrome, Edge and Safari */
  .pf-searchbox-results::-webkit-scrollbar {
    width: 18px;
    overflow-y: scroll;
  }

  .pf-searchbox-results::-webkit-scrollbar-track {
    background-color: var(--scrollbar-track);
  }

  .pf-searchbox-results::-webkit-scrollbar-thumb {
    background-clip: content-box;
    background-color: var(--color-green-800);
    border-radius: 50px;
    border: 6px solid transparent;
  }

  .pf-searchbox-results::-webkit-scrollbar-thumb:hover,
  .pf-searchbox-results::-webkit-scrollbar-thumb:active {
    background-color: var(--color-green-700);
  }
</style>
