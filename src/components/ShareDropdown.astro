---
const { description, title, tags, url } = Astro.props;
---

<button
  id="share-btn"
  popovertarget="share-popover"
  class="not-prose flex w-fit cursor-pointer flex-nowrap items-center gap-2 rounded-full border border-black/15 p-1.5 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black sm:rounded-sm sm:px-3 sm:py-1.5 dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white">
  <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
    ><path
      fill="currentColor"
      d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81c1.66 0 3-1.34 3-3s-1.34-3-3-3s-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65c0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92"
    ></path></svg
  >

  <span class="hidden text-sm sm:inline-block">Share</span>
</button>
<div
  id="share-popover"
  class="min-w-max"
  popover
  data-description={description}
  data-url={url}
  data-title={title}
  data-tags={tags}>
  <div
    role="menu"
    aria-orientation="vertical"
    class="popover-menu pointer-events-auto overflow-x-hidden overflow-y-auto rounded-md border border-black/15 bg-neutral-200 p-1 text-zinc-950 shadow-md outline-none dark:border-white/20 dark:bg-neutral-800 dark:text-zinc-50"
    tabindex="-1">
    <div role="group">
      <div
        id="share-facebook"
        role="menuitem"
        class="relative flex cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"
        tabindex="-1">
        <svg
          class="size-4"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4z"
          ></path></svg
        >
        <span>Facebook</span>
      </div>
      <div
        id="share-linkedin"
        role="menuitem"
        class="relative flex cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"
        tabindex="-1">
        <svg
          class="size-4"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="M6.94 5a2 2 0 1 1-4-.002a2 2 0 0 1 4 .002M7 8.48H3V21h4zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91z"
          ></path></svg
        >
        <span>LinkedIn</span>
      </div>

      <div
        id="share-x"
        role="menuitem"
        class="relative flex cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"
        tabindex="-1">
        <svg
          class="size-4"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="m17.687 3.063l-4.996 5.711l-4.32-5.711H2.112l7.477 9.776l-7.086 8.099h3.034l5.469-6.25l4.78 6.25h6.102l-7.794-10.304l6.625-7.571zm-1.064 16.06L5.654 4.782h1.803l10.846 14.34z"
          ></path></svg
        >
        <span>X</span>
      </div>
    </div>
    <div
      role="separator"
      aria-orientation="horizontal"
      class="-mx-1 my-1 h-px bg-black/10 dark:bg-white/10">
    </div>
    <div role="group">
      <div
        id="share-more"
        role="menuitem"
        class="relative flex cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"
        tabindex="-1">
        <svg
          class="size-4"
          xmlns="http://www.w3.org/2000/svg"
          width="512"
          height="512"
          viewBox="0 0 512 512"
          ><path
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="32"
            d="M336 192h40a40 40 0 0 1 40 40v192a40 40 0 0 1-40 40H136a40 40 0 0 1-40-40V232a40 40 0 0 1 40-40h40m160-64l-80-80l-80 80m80 193V48"
          ></path></svg
        >
        <span>More</span>
      </div>
    </div>
  </div>
</div>

<style>
  #share-btn {
    anchor-name: --share-anchor;
  }

  @position-try --br {
    position-area: bottom span-right;
  }

  @position-try --tl {
    position-area: top span-left;
  }

  #share-popover {
    position-anchor: --share-anchor;
    position-area: bottom span-left;
    position-try-fallbacks: --br, --tl;
    inset-block: 2px;
  }

  @keyframes enter {
    0% {
      opacity: 0;
      transform: translate3d(-1000px, -1000px, -1000px) scale3d(0.95, 0.95, 0.95) rotate(0);
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale3d(1, 1, 1) rotate(0);
    }
  }

  .popover-menu:popover-open {
    animation: enter 0.15s ease 0s 1 normal both;
  }
</style>

<script>
  import { generateShareLinks, socialWindow } from "@lib/generateShareLinks";
  const shareFacebook = document.querySelector("#share-facebook") as HTMLDivElement;
  const shareLinkedIn = document.querySelector("#share-linkedin") as HTMLDivElement;
  const shareX = document.querySelector("#share-x") as HTMLDivElement;
  const shareMore = document.querySelector("#share-more") as HTMLDivElement;

  const shareDataEl = document.querySelector("div[data-url]") as HTMLDivElement;
  const description = shareDataEl.getAttribute("data-description")!;
  const title = shareDataEl.getAttribute("data-title")!;
  const tags = shareDataEl.getAttribute("data-tags")!.split(",");
  const url = shareDataEl.getAttribute("data-url")!;

  const share = generateShareLinks({
    title,
    url,
    tags,
  });

  shareFacebook.addEventListener("click", () => {
    socialWindow(share.facebook);
  });

  shareLinkedIn.addEventListener("click", () => {
    socialWindow(share.linkedin);
  });

  shareX.addEventListener("click", () => {
    socialWindow(share.twitter);
  });

  shareMore.addEventListener("click", async () => {
    const shareData = {
      title,
      text: description,
      url,
    };

    try {
      if (navigator.canShare && navigator.canShare(shareData)) {
        await navigator.share(shareData);
      }
    } catch (error) {
      console.error("Error sharing:", error);
    }
  });
</script>
