---
const { prevSermon, nextSermon } = Astro.props;
---

<ul class="not-prose grid list-none grid-cols-2 gap-1.5 text-sm sm:gap-3">
  {
    prevSermon?.id ? (
      <li class="h-full">
        <a
          href={`/sermons/${prevSermon?.id}`}
          class="group relative flex h-full flex-nowrap items-center rounded-lg border border-black/15 px-4 py-3 pl-10 font-medium no-underline transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            class="absolute top-1/2 left-2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
            aria-hidden="true">
            <line
              x1="5"
              y1="12"
              x2="19"
              y2="12"
              class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
            />
            <polyline
              points="12 5 5 12 12 19"
              class="translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
            />
          </svg>

          <div class="line-clamp-2 text-sm">
            <span class="hidden">Previous sermon:</span> {prevSermon?.data.title}
          </div>
        </a>
      </li>
    ) : (
      <div class="invisible" />
    )
  }

  {
    nextSermon?.id ? (
      <li class="h-full">
        <a
          href={`/sermons/${nextSermon?.id}`}
          class="group relative flex h-full grow flex-row-reverse flex-nowrap items-center rounded-lg border border-black/15 px-4 py-4 pr-10 font-medium no-underline transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            class="absolute top-1/2 right-2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
            aria-hidden="true">
            <line
              x1="5"
              y1="12"
              x2="19"
              y2="12"
              class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
            />
            <polyline
              points="12 5 19 12 12 19"
              class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
            />
          </svg>
          <div class="line-clamp-2 text-sm">
            <span class="hidden">Next sermon:</span> {nextSermon?.data.title}
          </div>
        </a>
      </li>
    ) : (
      <div class="invisible" />
    )
  }
</ul>
