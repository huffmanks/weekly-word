---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  id: string;
}

const { id, class: className = "", ...rest } = Astro.props;
const anchorName = `--anchor-${id}`;
---

<div class="inline-flex" style={`anchor-name: ${anchorName}`}>
  <slot name="trigger" />
</div>

<div
  id={id}
  popover
  style={`position-anchor: ${anchorName}`}
  class:list={["popover-panel", className]}
  {...rest}>
  <slot />
</div>

<style>
  @position-try --top-left {
    position-area: top span-left;
  }

  .popover-panel {
    margin: 0;
    opacity: 0;
    transform: scale(0.95);
    transform-origin: top left;
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out,
      display 150ms allow-discrete,
      overlay 150ms allow-discrete;
  }

  .popover-panel:popover-open {
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    .popover-panel:popover-open {
      opacity: 0;
      transform: scale(0.95);
    }
  }

  @supports (anchor-name: --a) and (position-area: bottom span-left) {
    .popover-panel {
      position-area: bottom span-left;
      position-try-fallbacks: --top-left;
      inset-block-start: 4px;
    }
  }

  @supports not ((anchor-name: --a) and (position-area: bottom span-left)) {
    .popover-panel {
      position: fixed;
      inset: 3.5rem calc(50% - (var(--breakpoint-sm) / 2) + 12px) auto auto;
    }
  }
</style>
