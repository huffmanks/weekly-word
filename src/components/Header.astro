---
import { SITE_CONFIG } from "@constants";

import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---

<header transition:persist>
  <Container>
    <div data-pagefind-ignore class="flex flex-wrap items-center justify-between gap-y-2">
      <Link href="/" underline={false}>
        <div class="text-[17px] font-bold">
          {SITE_CONFIG.title}
        </div>
      </Link>
      <nav class="flex items-center gap-2 text-[15px]">
        <Link href="/sermons">sermons</Link>
        <span>&middot;</span>
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="group flex cursor-pointer items-center gap-1 rounded-sm border border-neutral-400 bg-transparent py-1 pr-2.5 pl-1.5 text-[13px] transition-colors duration-300 ease-in-out hover:bg-neutral-300 hover:text-black focus-visible:bg-neutral-300 focus-visible:text-black dark:border-neutral-700 dark:hover:bg-neutral-800 dark:hover:text-white dark:focus-visible:bg-neutral-800 dark:focus-visible:text-white">
          <svg
            height="16"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="16"
            style="color: currentcolor;">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor">
            </path>
          </svg>
          <span
            class="group-hover:text-neutral-900 group-focus-visible:text-neutral-900 dark:group-hover:text-neutral-100 dark:group-focus-visible:text-neutral-100"
            >search</span
          >
        </button>
      </nav>
    </div>
  </Container>
</header>
