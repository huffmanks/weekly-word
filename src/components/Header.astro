---
import { SITE_CONFIG } from "@constants";

import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---

<header transition:persist>
  <Container>
    <div data-pagefind-ignore class="flex flex-wrap items-end justify-between gap-y-2">
      <Link href="/" underline={false}>
        <div class="flex items-center gap-1">
          <svg
            class="size-4 fill-current sm:size-5"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24">
            <path
              d="M6 22h15v-2H6.012C5.55 19.988 5 19.805 5 19s.55-.988 1.012-1H21V4a2 2 0 0 0-2-2H6c-1.206 0-3 .799-3 3v14c0 2.201 1.794 3 3 3M8 7h3V5h2v2h3v2h-3v6h-2V9H8z">
            </path>
          </svg>
          <div class="font-bold sm:text-lg">
            {SITE_CONFIG.title}
          </div>
        </div>
      </Link>
      <div class="relative flex items-center gap-2">
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="group flex cursor-pointer items-center gap-1 rounded-sm border border-neutral-400 bg-transparent py-1 pr-2.5 pl-1.5 text-xs transition-colors duration-300 ease-in-out hover:bg-neutral-300 hover:text-black focus-visible:bg-neutral-300 focus-visible:text-black dark:border-neutral-700 dark:hover:bg-neutral-800 dark:hover:text-white dark:focus-visible:bg-neutral-800 dark:focus-visible:text-white">
          <svg
            height="16"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="16"
            style="color: currentcolor;">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor">
            </path>
          </svg>
          <span
            class="group-hover:text-neutral-900 group-focus-visible:text-neutral-900 dark:group-hover:text-neutral-100 dark:group-focus-visible:text-neutral-100"
            >search</span
          >
        </button>
        <button
          id="mobile-menu-btn-show"
          class="cursor-pointer rounded-sm px-2 py-1 transition-colors duration-300 ease-in-out hover:bg-neutral-300 hover:text-black focus-visible:bg-neutral-300 focus-visible:text-black dark:hover:bg-neutral-800 dark:hover:text-white dark:focus-visible:bg-neutral-800 dark:focus-visible:text-white"
          popovertarget="mobile-menu"
          popovertargetaction="show"
          aria-label="Open mobile menu"
          aria-controls="mobile-menu">
          <svg
            class="size-5"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M7 5h10M4 12h16M7 19h10">
            </path>
          </svg>
        </button>

        <nav
          id="mobile-menu"
          popover
          class="w-72 max-w-[calc(100%-0.75rem)] rounded-md border border-neutral-300 bg-neutral-200 dark:border-neutral-700 dark:bg-neutral-800">
          <div role="menu" class="popover-menu relative">
            <button
              id="mobile-menu-btn-close"
              class="absolute top-2 right-2 cursor-pointer self-end hover:opacity-70 focus-visible:opacity-70"
              popovertarget="mobile-menu"
              popovertargetaction="hide"
              aria-label="Close mobile menu"
              aria-controls="mobile-menu">
              <svg
                class="size-5"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24">
                <path
                  fill="currentColor"
                  d="M18.3 5.71a.996.996 0 0 0-1.41 0L12 10.59L7.11 5.7A.996.996 0 1 0 5.7 7.11L10.59 12L5.7 16.89a.996.996 0 1 0 1.41 1.41L12 13.41l4.89 4.89a.996.996 0 1 0 1.41-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4">
                </path>
              </svg>
            </button>
            <div class="flex flex-col gap-2 p-4">
              <Link href="/sermons">sermons</Link>
              <Link href="/series">series</Link>
              <Link href="/pastors">pastors</Link>
              <Link href="/podcasts">podcasts</Link>
              <hr class="mt-3 mb-1.5 border-neutral-300 dark:border-neutral-700" />
              <Link href="/verses/weekly">weekly verses</Link>
              <Link href="/purposes">purposes</Link>
            </div>
          </div>
        </nav>
      </div>
    </div>
  </Container>
</header>

<style>
  #mobile-menu-btn-show {
    anchor-name: --menu-anchor;
  }

  @position-try --br {
    position-area: bottom span-right;
  }

  @position-try --tl {
    position-area: top span-left;
  }

  #mobile-menu {
    position-anchor: --menu-anchor;
    position-area: bottom span-left;
    position-try-fallbacks: --br, --tl;
    inset-block: 2px;
  }

  @keyframes enter {
    0% {
      opacity: 0;
      transform: translate3d(-1000px, -1000px, -1000px) scale3d(0.95, 0.95, 0.95) rotate(0);
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale3d(1, 1, 1) rotate(0);
    }
  }

  .popover-menu:popover-open {
    animation: enter 0.15s ease 0s 1 normal both;
  }
</style>
