---
import { formatApDateRange } from "@lib/formatApDateRange";
import { cn } from "@lib/utils";

type Props = {
  id: string;
  title: string;
  count: number;
  firstDate: Date;
  lastDate: Date;
};

const { id, title, count, firstDate, lastDate } = Astro.props;

const apDateRange = formatApDateRange(firstDate, lastDate);
---

<a
  href={`/series/${id}`}
  class={cn(
    "not-prose group relative block rounded-lg border border-neutral-300 px-4 py-3 pr-10 transition-colors duration-300 ease-in-out hover:bg-neutral-200 hover:text-black focus-visible:bg-neutral-200 focus-visible:text-black dark:border-neutral-700 dark:hover:bg-neutral-800 dark:hover:text-white dark:focus-visible:bg-neutral-800 dark:focus-visible:text-white",
    id === "uncategorized" && "items-center"
  )}>
  <div>
    <div class="flex items-center gap-1">
      <span class="truncate font-bold">
        {title}
      </span>
      <span
        class="text-sm text-neutral-500 transition-colors duration-300 ease-in-out group-hover:text-neutral-900 group-focus-visible:text-neutral-900 dark:group-hover:text-neutral-100 dark:group-focus-visible:text-neutral-100">
        ({count})
      </span>
    </div>
    {
      id !== "uncategorized" && (
        <div class="text-xs font-medium text-neutral-600 dark:text-neutral-400">{apDateRange}</div>
      )
    }
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2">
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100">
    </line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0">
    </polyline>
  </svg>
</a>
