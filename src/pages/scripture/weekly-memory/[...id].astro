---
import fs from "node:fs";
import path from "node:path";

import { generateBibleUrl } from "@lib/generateBibleUrl";
import { generateWeeklyMemoryMeta } from "@lib/generateScriptureMeta";
import type { WeeklyMemory } from "@types";

import Container from "@components/Container.astro";
import GoToButton from "@components/GoToButton.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const filePath = path.join(process.cwd(), "src", "data", "scripture_weekly-memory.json");
  const fileData = fs.readFileSync(filePath, "utf-8");
  const data = JSON.parse(fileData) as WeeklyMemory[];

  return data.map((item) => {
    return {
      params: { id: String(item.id) },
      props: { item, totalCount: data.length },
    };
  });
}

const { item, totalCount } = Astro.props;

const { title, label } = generateWeeklyMemoryMeta(item.id);
const bibleHref = generateBibleUrl(item.verse);

const isPreviousDisabled = item.id < 2;
const previousHref = !isPreviousDisabled ? `/scripture/weekly-memory/${item.id - 1}` : null;
const isNextDisabled = item.id === totalCount;
const nextHref = !isNextDisabled ? `/scripture/weekly-memory/${item.id + 1}` : null;
---

<BaseLayout title={title} description=`Memorize ${item.verse} for week #${item.id}.`>
  <Container>
    <div class="p-1.5">
      <div class="animate mb-4 flex items-center justify-between gap-4">
        <span
          class="-ml-0.75 inline-flex rounded-md bg-neutral-300 px-1.5 py-1 text-sm font-medium dark:bg-neutral-800">
          {label}
        </span>
        <a
          href={bibleHref}
          target="_blank"
          class="not-prose flex w-fit cursor-pointer flex-nowrap items-center gap-2 rounded-full border border-black/15 p-1.5 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black sm:rounded-sm sm:px-3 sm:py-1.5 dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white">
          <svg
            class="size-4 fill-current"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24">
            <path
              d="M6 22h15v-2H6.012C5.55 19.988 5 19.805 5 19s.55-.988 1.012-1H21V4a2 2 0 0 0-2-2H6c-1.206 0-3 .799-3 3v14c0 2.201 1.794 3 3 3M8 7h3V5h2v2h3v2h-3v6h-2V9H8z">
            </path>
          </svg>
          <span class="hidden text-sm sm:inline-block">Open in Bible</span>
        </a>
      </div>

      <h1 class="animate mb-2 text-xl font-bold text-black dark:text-white">
        {item.verse}
      </h1>

      <p class="animate mb-8 font-medium">{item.text}</p>

      <div class="animate mb-6 flex items-center justify-between gap-4">
        <GoToButton href={previousHref} isDisabled={isPreviousDisabled}>Previous</GoToButton>
        <GoToButton href={nextHref} isNext isDisabled={isNextDisabled}>Next</GoToButton>
      </div>
    </div>
  </Container>
</BaseLayout>
