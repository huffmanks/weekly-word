---
import weeklyVerses from "@/data/scripture_weekly-memory.json";
import BaseLayout from "@layouts/BaseLayout.astro";

const availableIds = weeklyVerses.map(({ id }) => id).sort((a, b) => a - b);
---

<BaseLayout title="Redirecting..." description="Going to this week's memory verse.">
  <div id="schedule-data" data-ids={JSON.stringify(availableIds)}></div>

  <script>
    import { generateWeeklyMemoryMeta } from "@lib/generateScriptureMeta";

    const dataEl = document.getElementById("schedule-data");
    const ids: Array<number> = dataEl ? JSON.parse(dataEl.dataset.ids || "[]") : [];

    const { weekNumber } = generateWeeklyMemoryMeta();

    const targetId =
      ids.find((id) => id === weekNumber) ||
      ids.find((id) => id > weekNumber) ||
      ids[ids.length - 1];

    if (targetId) {
      window.location.replace(`/scripture/weekly-memory/${targetId}`);
    }
  </script>
</BaseLayout>
