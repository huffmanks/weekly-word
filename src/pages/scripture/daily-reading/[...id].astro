---
import fs from "node:fs";
import path from "node:path";

import { generateBibleUrl } from "@lib/generateBibleUrl";
import { generateDailyReadingMeta } from "@lib/generateScriptureMeta";
import { readingTime } from "@lib/utils";
import type { DailyReading } from "@types";

import Container from "@components/Container.astro";
import GoToButton from "@components/GoToButton.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const filePath = path.join(process.cwd(), "src", "data", "scripture_daily-reading.json");
  const fileData = fs.readFileSync(filePath, "utf-8");
  const data = JSON.parse(fileData) as Array<DailyReading>;

  const maxId = data.length > 0 ? data[data.length - 1].id : 0;

  return data.map((item) => {
    return {
      params: { id: String(item.id) },
      props: { item, maxId },
    };
  });
}

const { item, maxId } = Astro.props;

const { title, label, description } = generateDailyReadingMeta(item.date);
const bibleHref = generateBibleUrl(item.chapter);

const isPreviousDisabled = item.id < 2;
const previousHref = !isPreviousDisabled ? `/scripture/daily-reading/${item.id - 1}` : null;
const isNextDisabled = item.id === maxId;
const nextHref = !isNextDisabled ? `/scripture/daily-reading/${item.id + 1}` : null;

const itemVersesHtml = item.verses
  .map(
    (v) => `
    <span class="text-right text-black/60 dark:text-white/50">${v.number}</span>
    <span>${v.text}</span>
  `
  )
  .join("");
---

<BaseLayout title={title} description={description}>
  <Container>
    <div class="p-1.5">
      <div class="animate mb-8 flex items-center justify-between gap-4">
        <span
          class="-ml-0.75 inline-flex rounded-md bg-neutral-300 px-1.5 py-1 text-sm font-medium dark:bg-neutral-800">
          {label}
        </span>
        <a
          href={bibleHref}
          target="_blank"
          class="not-prose flex w-fit cursor-pointer flex-nowrap items-center gap-2 rounded-full border border-black/15 p-1.5 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black sm:rounded-sm sm:px-3 sm:py-1.5 dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white">
          <svg
            class="size-4 fill-current"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24">
            <path
              d="M6 22h15v-2H6.012C5.55 19.988 5 19.805 5 19s.55-.988 1.012-1H21V4a2 2 0 0 0-2-2H6c-1.206 0-3 .799-3 3v14c0 2.201 1.794 3 3 3M8 7h3V5h2v2h3v2h-3v6h-2V9H8z">
            </path>
          </svg>
          <span class="hidden text-sm sm:inline-block">Open in Bible</span>
        </a>
      </div>

      <div class="animate mb-3 flex flex-wrap items-center gap-2">
        <h1 class="text-xl font-bold text-black dark:text-white">
          {item.chapter}
        </h1>
        <span>&bull;</span>
        <div class="text-sm font-medium text-black/60 dark:text-white/50">
          {item.verses.length} verses
        </div>
        <span>&bull;</span>
        <div class="text-sm font-medium text-black/60 dark:text-white/50">
          {readingTime(itemVersesHtml)}
        </div>
      </div>

      <div class="relative flex min-h-screen flex-col">
        <div class="flex-grow">
          <div
            class="animate mb-8 grid grid-cols-[auto_1fr] gap-x-2 gap-y-3 text-lg font-medium"
            set:html={itemVersesHtml}
          />
        </div>

        <div class="sticky bottom-0 z-40">
          <div
            class="mx-auto max-w-(--breakpoint-sm) bg-neutral-100/75 py-5 saturate-200 backdrop-blur-xs dark:bg-neutral-900/75">
            <div class="animate flex items-center justify-between gap-4">
              <GoToButton href={previousHref} isDisabled={isPreviousDisabled}>Prev</GoToButton>
              <div class="flex flex-col items-center gap-x-2 gap-y-1 sm:flex-row">
                <span class="text-center text-[11px] leading-none font-bold sm:text-sm">
                  {item.chapter}
                </span>
                <span class="hidden text-sm text-black/60 sm:inline-block dark:text-white/50">
                  &bull;
                </span>
                <span
                  class="sm:text-black/85a sm:dark:text-white/85a text-center text-[11px] leading-none font-bold text-black/60 sm:text-sm dark:text-white/50">
                  {label}
                </span>
              </div>
              <GoToButton href={nextHref} isNext isDisabled={isNextDisabled}>Next</GoToButton>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>
