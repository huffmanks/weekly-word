---
import weeklyVerses from "@/data/scripture_daily-reading.json";
import BaseLayout from "@layouts/BaseLayout.astro";

const schedule = weeklyVerses.map(({ date, id }) => ({ date, id }));
---

<BaseLayout title="Redirecting..." description="Going to today's daily reading.">
  <div id="schedule-data" data-schedule={JSON.stringify(schedule)}></div>

  <script>
    import { generateDailyReadingMeta } from "@lib/generateScriptureMeta";
    import { paramOverrideDateTime } from "@lib/utils";
    import type { DailyReading } from "@types";

    const dataEl = document.getElementById("schedule-data");
    const schedule = dataEl
      ? (JSON.parse(dataEl.dataset.schedule || "[]") as Array<DailyReading>)
      : [];

    const urlParams = new URLSearchParams(window.location.search);
    const paramDate = urlParams.get("date");
    const paramTime = urlParams.get("time") || "00:00";

    if (paramDate) {
      paramOverrideDateTime(paramDate, paramTime);
    }

    const { date: targetDate } = generateDailyReadingMeta();

    const match =
      schedule.find((item) => item.date === targetDate) ||
      schedule.find((item) => item.date > targetDate) ||
      schedule[schedule.length - 1];

    if (match) {
      window.location.replace(`/scripture/daily-reading/${match.id}`);
    }
  </script>
</BaseLayout>
