---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Container from "@components/Container.astro";

const sermons = await getCollection("sermons", ({ data }) => !data.draft);
const seriesList = await getCollection("series");
---

<BaseLayout title="Series" description="List of all series in collection.">
  <Container>
    <div data-pagefind-ignore class="space-y-10">
      <h1 class="animate font-bold">All Series</h1>
      <div class="animate flex flex-wrap gap-2">
        {
          seriesList.map((series) => {
            const count = sermons.filter((sermon) => sermon.data.series.id === series.id).length;

            return (
              <a
                href={`/series/${series.id}`}
                class="group flex gap-1 rounded-sm border border-neutral-400 px-2 py-1 text-sm transition-colors duration-300 ease-in-out hover:bg-neutral-300 hover:text-black focus-visible:bg-neutral-300 focus-visible:text-black dark:border-neutral-700 dark:hover:bg-neutral-800 dark:hover:text-white dark:focus-visible:bg-neutral-800 dark:focus-visible:text-white">
                <span>{series.data.title}</span>
                <span class="text-sm text-neutral-500 transition-colors duration-300 ease-in-out group-hover:text-neutral-900 group-focus-visible:text-neutral-900 dark:group-hover:text-neutral-100 dark:group-focus-visible:text-neutral-100">
                  ({count})
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </Container>
</BaseLayout>
