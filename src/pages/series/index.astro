---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Container from "@components/Container.astro";
import SeriesCard from "@components/SeriesCard.astro";

const sermons = await getCollection("sermons", ({ data }) => !data.draft);
const series = await getCollection("series");

const sortedSeries = series
  .map((item) => {
    const relatedSermons = sermons.filter((sermon) => sermon.data.series.id === item.id);

    const dates = relatedSermons.map((s) => s.data.date.getTime());

    const firstDate = new Date(Math.min(...dates));
    const lastDate = new Date(Math.max(...dates));

    return { ...item, firstDate, lastDate };
  })
  .sort((a, b) => {
    if (a.firstDate && b.firstDate)
      return new Date(b.firstDate).getTime() - new Date(a.firstDate).getTime();
    if (a.firstDate && !b.firstDate) return -1;
    if (!a.firstDate && b.firstDate) return 1;
    return a.data.title.localeCompare(b.data.title);
  });

const seriesCount = series.length;
---

<BaseLayout title="Series" description="List of all series in collection.">
  <Container>
    <div data-pagefind-ignore class="space-y-10">
      <h1 class="animate inline-flex items-center gap-1">
        <span class="text-xl font-bold">All series</span>
        <span
          class="text-sm text-neutral-500 transition-colors duration-300 ease-in-out group-hover:text-neutral-900 group-focus-visible:text-neutral-900 dark:group-hover:text-neutral-100 dark:group-focus-visible:text-neutral-100">
          ({seriesCount})
        </span>
      </h1>
      <div class="animate grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          sortedSeries.map((series) => {
            const count = sermons.filter((sermon) => sermon.data.series.id === series.id).length;

            return (
              <SeriesCard
                id={series.id}
                title={series.data.title}
                count={count}
                firstDate={series.firstDate}
                lastDate={series.lastDate}
              />
            );
          })
        }
      </div>
    </div>
  </Container>
</BaseLayout>
