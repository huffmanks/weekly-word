---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const purposes = await getCollection("purposes");
---

<BaseLayout
  title="Purpose Driven Life"
  description="List of all the days in a Purpose Driven Life.">
  <div class="mx-auto max-w-(--breakpoint-sm) px-3 py-6">
    {
      purposes.map((group) => (
        <section class="mb-8 flex flex-col gap-8 not-last:border-b not-last:pb-12">
          <h2 class="mb-2 text-2xl font-bold">{group.data.purpose}</h2>
          {group.data.group.map((item) => (
            <article
              class="relative overflow-hidden rounded-md bg-cover bg-center"
              style={{ backgroundImage: `url(${item.img})` }}>
              <div class="absolute inset-0 z-0 bg-black/70 backdrop-blur-xs" />
              <div class="relative z-10 p-8">
                <h3 class="mt-0 mb-1 drop-shadow-md">Day {item.day}</h3>
                <h4 class="mt-0 mb-3 drop-shadow-md">{item.title}</h4>
                <p class="mt-0 mb-2">
                  <strong>Point:</strong> {item.point}
                </p>
                <p class="mt-0 mb-2">
                  <strong>Verse:</strong> {item.verse}
                </p>
                <p class="my-0">
                  <strong>Question:</strong> {item.question}
                </p>
              </div>
            </article>
          ))}
        </section>
      ))
    }
  </div>
</BaseLayout>
