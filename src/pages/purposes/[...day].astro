---
import { getCollection } from "astro:content";

import GoToButton from "@components/GoToButton.astro";
import PurposeCard from "@components/PurposeCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const collection = await getCollection("purposes");
  const allPurposes = collection[0].data;

  const totalCount = allPurposes.reduce((acc, purpose) => acc + purpose.group.length, 0);

  return allPurposes.flatMap((purpose) =>
    purpose.group.map((item) => ({
      params: { day: item.day.toString() },
      props: { item, totalCount },
    }))
  );
}

const { item, totalCount } = Astro.props;

const isPreviousDisabled = item.day < 2;
const previousHref = !isPreviousDisabled ? `/purposes/${item.day - 1}` : null;
const isNextDisabled = item.day === totalCount;
const nextHref = !isNextDisabled ? `/purposes/${item.day + 1}` : null;
---

<BaseLayout title={item.title} description={item.point} image={item.img}>
  <div class="mx-auto max-w-(--breakpoint-sm) px-3 py-6">
    <div class="space-y-10">
      <GoToButton href={`/purposes#${item.id}`}>All purposes</GoToButton>
      <PurposeCard item={item} linkToDay={false} />
      <div class="animate mb-6 flex items-center justify-between gap-4">
        <GoToButton href={previousHref} isDisabled={isPreviousDisabled}>Prev</GoToButton>
        <GoToButton href={nextHref} isNext isDisabled={isNextDisabled}>Next</GoToButton>
      </div>
    </div>
  </div>
</BaseLayout>
