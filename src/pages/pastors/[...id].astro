---
import { getCollection, getEntry } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import BackToPrevious from "@components/BackToPrevious.astro";
import Container from "@components/Container.astro";
import SermonCard from "@components/SermonCard.astro";

export async function getStaticPaths() {
  const sermons = await getCollection("sermons", ({ data }) => !data.draft);

  const pastors = [...new Set(sermons.flatMap((sermon) => sermon.data.pastor || []))];

  return pastors.map((item) => ({
    params: { id: item.id },
    props: {
      sermons: sermons
        .filter((sermon) => sermon.data.pastor.id === item.id)
        .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()),
    },
  }));
}

const { sermons } = Astro.props;

const count = sermons.length;

const pastorId = sermons[0].data.pastor.id;
const pastor = await getEntry("pastors", pastorId);

const pastorName = pastor?.data.name ? pastor.data.name : "pastor";
const metaDescription = `Past sermons from ${pastorName}.`;
---

<BaseLayout title={pastorName} description={metaDescription}>
  <Container>
    <div data-pagefind-ignore class="space-y-10">
      <BackToPrevious href="/pastors">All pastors</BackToPrevious>
      <h1 class="animate mb-2 text-xl font-bold text-black dark:text-white">
        {pastorName}
      </h1>
      <p class="text-sm font-medium">
        {pastor?.data.title}<br />{pastor?.data.church.title}<br />{pastor?.data.church.location}
      </p>

      <div class="mb-3 inline-flex items-center gap-1.5">
        <h2 class="text-lg font-bold">Past sermons</h2>
        <span
          class="text-sm text-neutral-500 transition-colors duration-300 ease-in-out group-hover:text-neutral-900 group-focus-visible:text-neutral-900 dark:group-hover:text-neutral-100 dark:group-focus-visible:text-neutral-100">
          ({count})
        </span>
      </div>

      <ul class="animate flex flex-col gap-4">
        {sermons.map((sermon) => <SermonCard hidePastorBadge entry={sermon} />)}
      </ul>
    </div>
  </Container>
</BaseLayout>
