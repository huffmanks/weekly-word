---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import BackToPrevious from "@components/BackToPrevious.astro";
import Container from "@components/Container.astro";
import PodcastCard from "@components/PodcastCard.astro";

export async function getStaticPaths() {
  const sermons = (await getCollection("sermons", ({ data }) => !data.draft)).filter((sermon) => {
    const p = sermon.data.podcast;
    return p && Object.values(p).every((value) => value != null);
  });

  const years = [
    ...new Set(sermons.map((sermon) => new Date(sermon.data.date).getFullYear().toString())),
  ];

  return years.map((year) => {
    const filteredSermons = sermons
      .filter((sermon) => new Date(sermon.data.date).getFullYear().toString() === year)
      .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

    return {
      params: { year },
      props: {
        year,
        sermons: filteredSermons,
      },
    };
  });
}

const { sermons, year } = Astro.props;

const sermonCount = sermons.length;
---

<BaseLayout title={`${year} podcasts`} description={`Podcasts from ${year}`}>
  <Container>
    <div data-pagefind-ignore class="space-y-10">
      <BackToPrevious href="/podcasts">All podcasts</BackToPrevious>
      <h1 class="animate mb-4 inline-flex items-center gap-1">
        <span class="text-xl font-bold">{year}</span>
        <span
          class="text-sm text-neutral-500 transition-colors duration-300 ease-in-out group-hover:text-neutral-900 group-focus-visible:text-neutral-900 dark:group-hover:text-neutral-100 dark:group-focus-visible:text-neutral-100">
          ({sermonCount})
        </span>
      </h1>

      <ul class="animate grid grid-cols-[repeat(auto-fill,_minmax(min(240px,100%),_1fr))] gap-4">
        {sermons.map((sermon) => <PodcastCard entry={sermon} />)}
      </ul>
    </div>
  </Container>
</BaseLayout>
